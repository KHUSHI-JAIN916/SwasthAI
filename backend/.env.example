# ==============================================================================
# SWASTHAI Clinical Management Platform - Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://127.0.0.1:27017/swasthai
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/swasthai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/swasthai

# JWT Authentication
# Replace with a cryptographically strong random string in production (e.g. openssl rand -base64 48)
JWT_SECRET=swasthai_clinical_secure_jwt_secret_key_2026_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
# Set to specific frontend origin in production (e.g. http://localhost:8080 or https://swasthai.app)
CLIENT_URL=*

# Clinical AI Assistant Integration (Optional - Falls back to rule-based clinical engine if empty)
AI_API_KEY=
AI_PROVIDER=gemini

# File Uploads Directory (Relative to backend or absolute path)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

